# --- Supabase ---
VITE_SUPABASE_URL=https://xxxx.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# --- Platform LINE OA (only one for the whole platform) ---
VITE_LIFF_ID=
VITE_LINE_ADD_FRIEND_URL=https://line.me/R/ti/p/@your-platform-oa
